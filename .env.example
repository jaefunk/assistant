# 로컬 실행 시 .env 로 복사해서 채우세요. GitHub Actions 에서는 Repository Secrets 로 등록합니다.
ANTHROPIC_API_KEY=
# 키가 워크스페이스에 묶여 있지 않으면 필요 (Console → Workspaces 에서 확인)
ANTHROPIC_WORKSPACE_ID=

# 메일 발송 (Gmail 기준). SMTP_PASSWORD 는 Google 계정의 '앱 비밀번호'.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
MAIL_FROM=
