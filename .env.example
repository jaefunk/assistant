# 로컬 실행 시 .env 로 복사해서 채우세요. GitHub Actions 에서는 Repository Secrets 로 등록합니다.
# 메일 발송 (Gmail 기준). SMTP_PASSWORD 는 Google 계정의 '앱 비밀번호'.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
MAIL_FROM=

# 휴대폰 푸시 (ntfy 앱에서 구독한 토픽). 없으면 푸시 생략. NTFY_SERVER 기본 https://ntfy.sh
NTFY_TOPIC=
NTFY_SERVER=
NTFY_TOKEN=

# KOPIS 공연예술통합전산망 오픈 API 키 (kopis.or.kr → 오픈API 신청). kopis 소스에 필요
KOPIS_API_KEY=
